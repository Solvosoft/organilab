msgid "Gas"
msgstr "Gas"

msgid "Líquido"
msgstr "Liquid"

msgid "Lentejas"
msgstr "Lentils"

msgid "Polvos finos/ alta densidadr"
msgstr "polid powder"

msgid "Sólidos granulares o cristalinos"
msgstr "Solid granular or crystalline"

msgid "Granza"
msgstr "Granza"

msgid "Sólidos"
msgstr "Solids"

msgid "Sólido en polvo"
msgstr "Solid powder"

msgid "Sólidos cristalinos"
msgstr "Solid crystalline"

msgid "Tabletas"
msgstr "Tablets"

msgid "Gaseoso"
msgstr "Gaseous"

msgid "Colloidal"
msgstr "Colloidal"

msgid "Kit"
msgstr "Kit"

msgid "Carbón solido"
msgstr "Solid Carbon"

msgid "Condiciones físicas que pueden causar accidentes"
msgstr "Physical conditions that can cause accidents"

msgid "Pisos mojados, resbaladizos o en mal estado"
msgstr "Wet, slippery, or damaged floors"

msgid "Maquinaria sin guardas de protección"
msgstr "Machinery without protective guards"

msgid "Instalaciones eléctricas deficientes o sin protección"
msgstr "Faulty or unprotected electrical installations"

msgid "Trabajo en alturas sin equipo de seguridad"
msgstr "Working at heights without safety equipment"

msgid "Almacenamiento inadecuado de materiales pesados"
msgstr "Improper storage of heavy materials"

msgid "Herramientas en mal estado o uso incorrecto"
msgstr "Damaged tools or incorrect use"

msgid "Señalización de seguridad deficiente o ausente"
msgstr "Poor or missing safety signage"

msgid "Materiales inflamables mal almacenados"
msgstr "Improperly stored flammable materials"

msgid "Riesgo de explosión por gases o presión"
msgstr "Risk of explosion from gases or pressure"

msgid "Falta de orden y limpieza en el área"
msgstr "Lack of order and cleanliness in the area"

msgid "Energía en el ambiente que puede dañar la salud"
msgstr "Environmental energy that can harm health"

msgid "Exposición a ruido elevado por maquinaria o equipos"
msgstr "Exposure to high noise from machinery or equipment"

msgid "Iluminación insuficiente en el área de trabajo"
msgstr "Insufficient lighting in the work area"

msgid "Exposición a temperaturas extremas, calor o frío"
msgstr "Exposure to extreme temperatures, heat or cold"

msgid "Vibraciones generadas por herramientas o equipos"
msgstr "Vibrations generated by tools or equipment"

msgid "Radiación no ionizante por equipos, lámparas o fuentes UV"
msgstr "Non-ionizing radiation from equipment, lamps, or UV sources"

msgid "Ventilación deficiente en espacios cerrados"
msgstr "Poor ventilation in enclosed spaces"

msgid "Cambios bruscos de temperatura en el ambiente"
msgstr "Sudden temperature changes in the environment"

msgid "Exposición prolongada a humedad"
msgstr "Prolonged exposure to humidity"

msgid "Presencia de polvo suspendido en el ambiente"
msgstr "Presence of suspended dust in the environment"

msgid "Presión atmosférica anormal en trabajos especiales"
msgstr "Abnormal atmospheric pressure in special work"

msgid "Sustancias que pueden ser tóxicas, corrosivas o peligrosas"
msgstr "Substances that can be toxic, corrosive, or hazardous"

msgid "Manipulación de sustancias tóxicas sin protección adecuada"
msgstr "Handling toxic substances without adequate protection"

msgid "Exposición a vapores, gases o aerosoles químicos"
msgstr "Exposure to chemical vapors, gases, or aerosols"

msgid "Almacenamiento incorrecto de productos químicos"
msgstr "Incorrect storage of chemical products"

msgid "Mezcla de sustancias incompatibles"
msgstr "Mixing of incompatible substances"

msgid "Derrames de productos químicos en el área de trabajo"
msgstr "Chemical spills in the work area"

msgid "Uso de solventes, ácidos o bases corrosivas"
msgstr "Use of corrosive solvents, acids, or bases"

msgid "Falta de rotulación en envases químicos"
msgstr "Missing labeling on chemical containers"

msgid "Inhalación de polvo químico o partículas peligrosas"
msgstr "Inhalation of chemical dust or hazardous particles"

msgid "Contacto directo con sustancias irritantes para la piel"
msgstr "Direct contact with skin-irritating substances"

msgid "Ausencia o desconocimiento de hojas de datos de seguridad"
msgstr "Absence or unfamiliarity with safety data sheets"

msgid "Agentes vivos que pueden causar enfermedades o infecciones"
msgstr "Living agents that can cause diseases or infections"

msgid "Contacto con sangre, fluidos corporales o material contaminado"
msgstr "Contact with blood, body fluids, or contaminated material"

msgid "Exposición a bacterias, virus, hongos o parásitos"
msgstr "Exposure to bacteria, viruses, fungi, or parasites"

msgid "Manipulación de muestras biológicas sin protección"
msgstr "Handling biological samples without protection"

msgid "Presencia de residuos biológicos mal gestionados"
msgstr "Presence of poorly managed biological waste"

msgid "Uso inadecuado de contenedores para material punzocortante"
msgstr "Improper use of sharps containers"

msgid "Limpieza deficiente de superficies contaminadas"
msgstr "Poor cleaning of contaminated surfaces"

msgid "Exposición a animales, insectos o vectores"
msgstr "Exposure to animals, insects, or vectors"

msgid "Falta de protocolos para manejo de material infeccioso"
msgstr "Lack of protocols for handling infectious material"

msgid "Riesgo de contaminación cruzada entre áreas"
msgstr "Risk of cross-contamination between areas"

msgid "Ausencia de lavado de manos o higiene adecuada"
msgstr "Lack of handwashing or adequate hygiene"

msgid "Condiciones que generan lesiones musculoesqueléticas"
msgstr "Conditions that cause musculoskeletal injuries"

msgid "Posturas forzadas durante la ejecución de tareas"
msgstr "Forced postures while performing tasks"

msgid "Levantamiento manual de cargas pesadas"
msgstr "Manual lifting of heavy loads"

msgid "Movimientos repetitivos de manos, brazos o espalda"
msgstr "Repetitive movements of hands, arms, or back"

msgid "Trabajo prolongado de pie o sentado sin pausas"
msgstr "Prolonged standing or sitting without breaks"

msgid "Altura inadecuada de mesas, sillas o estaciones de trabajo"
msgstr "Improper height of tables, chairs, or workstations"

msgid "Uso de herramientas que obligan a posiciones incómodas"
msgstr "Use of tools that force uncomfortable positions"

msgid "Esfuerzo físico excesivo durante la tarea"
msgstr "Excessive physical effort during the task"

msgid "Alcances frecuentes por encima del hombro"
msgstr "Frequent overhead reaching"

msgid "Manipulación de cargas sin ayuda mecánica"
msgstr "Handling loads without mechanical assistance"

msgid "Diseño inadecuado del puesto de trabajo"
msgstr "Poor workstation design"

msgid "Factores que afectan el bienestar mental y emocional"
msgstr "Factors that affect mental and emotional well-being"

msgid "Sobrecarga de trabajo o presión excesiva por tiempos de entrega"
msgstr "Work overload or excessive pressure from deadlines"

msgid "Jornadas prolongadas sin pausas adecuadas"
msgstr "Long working hours without adequate breaks"

msgid "Falta de claridad en funciones o responsabilidades"
msgstr "Lack of clarity in roles or responsibilities"

msgid "Conflictos laborales o mala comunicación en el equipo"
msgstr "Workplace conflicts or poor team communication"

msgid "Acoso laboral, trato irrespetuoso o intimidación"
msgstr "Workplace harassment, disrespectful treatment, or intimidation"

msgid "Falta de apoyo por parte de jefaturas o compañeros"
msgstr "Lack of support from supervisors or coworkers"

msgid "Trabajo monótono o con bajo control sobre la tarea"
msgstr "Monotonous work or low control over the task"

msgid "Exposición a usuarios agresivos o situaciones de tensión"
msgstr "Exposure to aggressive users or tense situations"

msgid "Cambios organizacionales sin comunicación adecuada"
msgstr "Organizational changes without adequate communication"

msgid "Desequilibrio entre carga laboral y recursos disponibles"
msgstr "Imbalance between workload and available resources"

msgid "El daño puede ocurrir rara vez o únicamente bajo condiciones excepcionales."
msgstr "The harm may occur rarely or only under exceptional conditions."

msgid "El daño puede ocurrir algunas veces, especialmente durante ciertas tareas o condiciones específicas."
msgstr "The harm may occur sometimes, especially during certain tasks or specific conditions."

msgid "El daño puede ocurrir con frecuencia, diariamente o casi siempre que se realiza la actividad."
msgstr "The harm may occur frequently, daily or almost every time the activity is performed."

msgid "Daños leves que requieren primeros auxilios o atención básica, sin incapacidad importante."
msgstr "Minor injuries requiring first aid or basic care, without significant disability."

msgid "Daños moderados que pueden generar incapacidad temporal o enfermedades reversibles."
msgstr "Moderate injuries that may cause temporary disability or reversible illness."

msgid "Daños graves, irreversibles, incapacitantes o que pueden causar la muerte."
msgstr "Severe, irreversible, disabling injuries, or injuries that may cause death."

msgid "No se requiere acción específica. Mantener las condiciones actuales."
msgstr "No specific action required. Maintain current conditions."

msgid "No se necesitan controles adicionales. Verificar periódicamente los controles existentes."
msgstr "No additional controls needed. Periodically verify existing controls."

msgid "Se deben hacer esfuerzos para reducir el riesgo. Establezca mejoras en un plazo determinado."
msgstr "Efforts should be made to reduce the risk. Set improvements within a defined timeframe."

msgid "No debe comenzarse el trabajo hasta reducir el riesgo. Se requiere acción urgente."
msgstr "Work should not begin until the risk is reduced. Urgent action is required."

msgid "No debe comenzar ni continuar el trabajo. Prohibir la actividad hasta eliminar el riesgo."
msgstr "Work must not begin or continue. Prohibit the activity until the risk is eliminated."
