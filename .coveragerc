# Se usa desde src/ (Makefile y tox hacen `cd src`), por eso `source = .`.
# Con `--parallel` cada trabajador escribe su propio .coverage.*; el hilo del live
# server de Selenium se mide gracias a `thread`. Unir con `coverage combine`.
[run]
source = .
omit =
    */migrations/*
    */templates/*
    */static/*
    */tests/*
    */tests.py
    organilab_test/*
    organilab/test_settings.py
    manage.py
    # Alcance: el código que alcanza una petición web. Fuera, con motivo:
    # comandos de gestión (operación puntual por consola, no web)
    */management/*
    # fuentes SDS externas: scraping de sitios de terceros, requieren red
    laboratory/sds_sources/*
    # puntos de entrada y configuración del proceso
    organilab/settings.py
    organilab/asettings.py
    organilab/aurls.py
    organilab/wsgi.py
    organilab/asgi.py
    organilab/celery.py
    # la propia instrumentación de pruebas (sonda de roles y rendimiento)
    presentation/probe.py
    presentation/perf.py
    presentation/perf_volume.py
concurrency = thread,multiprocessing
parallel = true
sigterm = true

[report]
# Mismo alcance al reportar: los datos ya medidos no pasan por el omit de [run].
omit =
    */migrations/*
    */templates/*
    */static/*
    */tests/*
    */tests.py
    organilab_test/*
    organilab/test_settings.py
    manage.py
    # Alcance: el código que alcanza una petición web. Fuera, con motivo:
    # comandos de gestión (operación puntual por consola, no web)
    */management/*
    # fuentes SDS externas: scraping de sitios de terceros, requieren red
    laboratory/sds_sources/*
    # puntos de entrada y configuración del proceso
    organilab/settings.py
    organilab/asettings.py
    organilab/aurls.py
    organilab/wsgi.py
    organilab/asgi.py
    organilab/celery.py
    # la propia instrumentación de pruebas (sonda de roles y rendimiento)
    presentation/probe.py
    presentation/perf.py
    presentation/perf_volume.py
#fail_under = 100
show_missing = True
skip_covered = True
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError

[html]
directory = ../htmlcov
skip_empty = True
skip_covered = True

[json]
output = ../roadmap/.coverage/coverage.json
